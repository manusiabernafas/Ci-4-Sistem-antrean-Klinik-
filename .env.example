#--------------------------------------------------------------------
# Salin file ini menjadi .env (setup.bat / setup.sh melakukannya otomatis)
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

# Kosongkan agar alamat terdeteksi otomatis (http://localhost/antrean-klinik/).
# Isi bila memakai domain, contoh: app.baseURL = 'https://antrean.klinikku.id/'
# app.baseURL = ''

database.default.hostname = localhost
database.default.database = antrean_klinik
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306
